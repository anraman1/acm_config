<mxfile host="app.diagrams.net">
<diagram name="Rich ACM ArgoCD Architecture">
<mxGraphModel><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>

<mxCell id="hub" value="ACM HUB&#10;• ACM Governance&#10;• Placement Decisions&#10;• Policies&#10;• OpenShift GitOps (ArgoCD)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="320" height="140" as="geometry"/></mxCell>

<mxCell id="appset" value="ApplicationSet&#10;ClusterDecisionResource Generator&#10;Select destination clusters by labels" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="370" y="190" width="280" height="100" as="geometry"/></mxCell>

<mxCell id="sp1" value="Spoke Cluster A&#10;ArgoCD (Pull Model)&#10;AppProjects Installed" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="sp2" value="Spoke Cluster B&#10;ArgoCD (Pull Model)&#10;AppProjects Installed" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="380" y="360" width="250" height="130" as="geometry"/></mxCell>
<mxCell id="sp3" value="Spoke Cluster C&#10;ArgoCD (Pull Model)&#10;AppProjects Installed" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="360" width="250" height="130" as="geometry"/></mxCell>

<mxCell id="proj" value="AppProject Controls&#10;• Allowed Repos&#10;• Allowed Namespaces&#10;• AD Group Access&#10;• Deployment Boundaries" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1030" y="350" width="240" height="150" as="geometry"/></mxCell>

<mxCell id="repoA" value="Team-A GitOps Repo&#10;/applications&#10;payment-dev.yaml&#10;payment-qa.yaml" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="250" height="120" as="geometry"/></mxCell>

<mxCell id="repoB" value="Team-B GitOps Repo&#10;/applications&#10;inventory-dev.yaml&#10;catalog-dev.yaml" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="380" y="580" width="250" height="120" as="geometry"/></mxCell>

<mxCell id="repoC" value="Team-C GitOps Repo&#10;/applications&#10;shipping-dev.yaml" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="580" width="250" height="120" as="geometry"/></mxCell>

<mxCell id="flow" value="Flow&#10;1. Platform creates AppProject&#10;2. AD group mapped to role&#10;3. AppSet selects cluster&#10;4. Team commits Application YAML&#10;5. ArgoCD creates Application&#10;6. Deploy only to approved namespace" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1030" y="560" width="240" height="170" as="geometry"/></mxCell>

<mxCell id="e1" edge="1" parent="1" source="hub" target="appset"><mxGeometry relative="1" as="geometry"/></mxCell>
