<mxfile host="app.diagrams.net">
  <diagram name="ACM-ArgoCD-Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="hub" value="ACM HUB&#10;ArgoCD&#10;ApplicationSet&#10;Cluster Generator" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="spoke1" value="Spoke Cluster 1&#10;ArgoCD&#10;AppProjects" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="spoke2" value="Spoke Cluster 2&#10;ArgoCD&#10;AppProjects" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="260" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="spokeN" value="Spoke Cluster N&#10;ArgoCD&#10;AppProjects" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="260" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="repoA" value="Team-A GitOps Repo&#10;applications/*.yaml" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="repoB" value="Team-B GitOps Repo&#10;applications/*.yaml" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="470" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="repoN" value="Team-N GitOps Repo&#10;applications/*.yaml" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="470" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="hub" target="spoke1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="hub" target="spoke2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="hub" target="spokeN">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" edge="1" parent="1" source="repoA" target="spoke1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="repoB" target="spoke2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="repoN" target="spokeN">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>